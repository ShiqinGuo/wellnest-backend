{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellnest-backend",
  "main": "src/entry.py",
  "account_id": "f7d270c033269eb91a14318e08bf0a74",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["python_workers"],
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true },
  "vars": {
    "WELLNEST_SECURE_COOKIES": "true",
    "WELLNEST_ORIGIN": "https://wellnest-assessment.shiqinguo-apps.workers.dev",
    "WELLNEST_PAYMENT_PUBLIC_URL": "https://wellnest-assessment.shiqinguo-apps.workers.dev",
    "WELLNEST_PAYMENT_PROVIDER_URL": "https://payment.internal",
    "WELLNEST_PAYMENT_MERCHANT_URL": "https://payment.internal"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "e021d6688cac42d288aa5159032fde8d" }
  ],
  "services": [
    { "binding": "PAYMENT_API", "service": "wellnest-backend" }
  ],
  "queues": {
    "producers": [
      { "binding": "PAYMENTS", "queue": "wellnest-payments" }
    ],
    "consumers": [
      {
        "queue": "wellnest-payments",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "retry_delay": 5,
        "dead_letter_queue": "wellnest-payments-dead"
      }
    ]
  },
  "triggers": { "crons": ["*/10 * * * *"] }
}
